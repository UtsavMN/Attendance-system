# ==============================================================================
# SCHOLARIS CONFIGURATION ENVIRONMENT VARIABLES
# ==============================================================================

# Django Core Settings
DJANGO_SECRET_KEY=scholaris-production-secret-key-change-in-prod-xyz123
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,scholaris.example.com

